{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173,
      "autoPort": false
    },
    {
      "name": "cms",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "cms",
        "run",
        "dev:local"
      ],
      "port": 3300
    },
    {
      "name": "site-built",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "--",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173,
      "autoPort": false
    }
  ]
}
