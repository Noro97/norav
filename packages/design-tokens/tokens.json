{
  "$description": "The design tokens for norav.dev, in the W3C Design Tokens (DTCG) shape. `npm run tokens` regenerates tokens.css and src/index.ts from this file; nothing else is hand-edited. Names are [category]-[property]-[variant][-breakpoint]. A `{path}` value is an alias; `$extensions.norav.alpha` mixes an alias with transparent.",

  "color": {
    "$description": "Two layers. `physical` is what the CMS writes onto :root at publish — the accent scales and the surfaces derived from the background; the values here are defaults for a page with no theme yet. Everything else is an alias onto it, which is how a theme change repaints the whole system.",
    "physical": {
      "crimson": {
        "50": { "$type": "color", "$value": "#fef2f3" },
        "100": { "$type": "color", "$value": "#fde6e8" },
        "200": { "$type": "color", "$value": "#fbc9cd" },
        "300": { "$type": "color", "$value": "#f7a0a6" },
        "400": { "$type": "color", "$value": "#d63040" },
        "500": { "$type": "color", "$value": "#B51A2B" },
        "600": { "$type": "color", "$value": "#8c1523" },
        "700": { "$type": "color", "$value": "#541A2E" },
        "800": { "$type": "color", "$value": "#3d1322" },
        "900": { "$type": "color", "$value": "#2a0e17" }
      },
      "cyan": {
        "50": { "$type": "color", "$value": "#f5fcfd" },
        "100": { "$type": "color", "$value": "#ebf9fb" },
        "200": { "$type": "color", "$value": "#d7f2f6" },
        "300": { "$type": "color", "$value": "#b9e9f0" },
        "400": { "$type": "color", "$value": "#47daf1" },
        "500": { "$type": "color", "$value": "#22d3ee" },
        "600": { "$type": "color", "$value": "#0fadc5" },
        "700": { "$type": "color", "$value": "#1d6975" },
        "800": { "$type": "color", "$value": "#154c55" },
        "900": { "$type": "color", "$value": "#0f353a" }
      },
      "background": { "$type": "color", "$value": "#0a0a1a" },
      "card": { "$type": "color", "$value": "#0d0d1f" },
      "muted": { "$type": "color", "$value": "#1a1a2e" },
      "secondary": { "$type": "color", "$value": "#1a1a2e", "$description": "Legacy name for the raised surface; the theme still writes it." },
      "foreground": { "$type": "color", "$value": "#e0e0e0" },
      "card-foreground": { "$type": "color", "$value": "#e0e0e0" },
      "secondary-foreground": { "$type": "color", "$value": "#e0e0e0" },
      "muted-foreground": { "$type": "color", "$value": "#888888" },
      "border": { "$type": "color", "$value": "rgba(255, 255, 255, 0.08)" },
      "input": { "$type": "color", "$value": "rgba(255, 255, 255, 0.06)" },
      "ink": { "$type": "color", "$value": "#ffffff", "$description": "The pole the neutral alphas mix from: white on a dark background, black on a light one." },
      "primary": { "$type": "color", "$value": "#B51A2B" },
      "primary-foreground": { "$type": "color", "$value": "#ffffff" },
      "accent": { "$type": "color", "$value": "#B51A2B" },
      "accent-foreground": { "$type": "color", "$value": "#ffffff" },
      "ring": { "$type": "color", "$value": "#B51A2B" },
      "success": { "$type": "color", "$value": "#22c55e" },
      "warning": { "$type": "color", "$value": "#eab308" },
      "danger": { "$type": "color", "$value": "#ef4444" },
      "info": { "$type": "color", "$value": "#38bdf8" }
    },

    "primary": {
      "$description": "The brand. The accent the owner chose in the CMS, and the one colour of emphasis on a view.",
      "50": { "$type": "color", "$value": "{color.physical.crimson.50}" },
      "100": { "$type": "color", "$value": "{color.physical.crimson.100}" },
      "200": { "$type": "color", "$value": "{color.physical.crimson.200}" },
      "300": { "$type": "color", "$value": "{color.physical.crimson.300}" },
      "400": { "$type": "color", "$value": "{color.physical.crimson.400}" },
      "500": { "$type": "color", "$value": "{color.physical.crimson.500}" },
      "600": { "$type": "color", "$value": "{color.physical.crimson.600}" },
      "700": { "$type": "color", "$value": "{color.physical.crimson.700}" },
      "800": { "$type": "color", "$value": "{color.physical.crimson.800}" },
      "900": { "$type": "color", "$value": "{color.physical.crimson.900}" },
      "fg": { "$type": "color", "$value": "{color.physical.primary-foreground}" }
    },
    "secondary": {
      "$description": "The supporting accent: case studies, the interactive widgets, and the categorical colour.",
      "50": { "$type": "color", "$value": "{color.physical.cyan.50}" },
      "100": { "$type": "color", "$value": "{color.physical.cyan.100}" },
      "200": { "$type": "color", "$value": "{color.physical.cyan.200}" },
      "300": { "$type": "color", "$value": "{color.physical.cyan.300}" },
      "400": { "$type": "color", "$value": "{color.physical.cyan.400}" },
      "500": { "$type": "color", "$value": "{color.physical.cyan.500}" },
      "600": { "$type": "color", "$value": "{color.physical.cyan.600}" },
      "700": { "$type": "color", "$value": "{color.physical.cyan.700}" },
      "800": { "$type": "color", "$value": "{color.physical.cyan.800}" },
      "900": { "$type": "color", "$value": "{color.physical.cyan.900}" }
    },
    "tertiary": {
      "$description": "The neutral role: surfaces, hairlines, text tones, disabled states. Named by purpose, not by step — the same name is white on a dark theme and black on a light one.",
      "bg": { "$type": "color", "$value": "{color.physical.background}", "$description": "the page" },
      "card": { "$type": "color", "$value": "{color.physical.card}", "$description": "a card on it" },
      "raised": { "$type": "color", "$value": "{color.physical.muted}", "$description": "a panel above that" },
      "fg": { "$type": "color", "$value": "{color.physical.foreground}", "$description": "body text" },
      "muted": { "$type": "color", "$value": "{color.physical.muted-foreground}", "$description": "secondary text" },
      "line": { "$type": "color", "$value": "{color.physical.border}", "$description": "hairlines, 8% ink" },
      "line-soft": { "$type": "color", "$value": "{color.physical.input}", "$description": "input borders, 6% ink" },
      "ink": { "$type": "color", "$value": "{color.physical.ink}", "$description": "the pole the neutral alphas mix from" },
      "shade": { "$type": "color", "$value": "#000000", "$description": "the other pole — scrims and code panels, dark on any theme" }
    },
    "status": {
      "$description": "Meaning, not brand: the one set outside the three roles. Only for state a reader has to read correctly.",
      "success": { "$type": "color", "$value": "{color.physical.success}" },
      "warning": { "$type": "color", "$value": "{color.physical.warning}" },
      "danger": { "$type": "color", "$value": "{color.physical.danger}" },
      "info": { "$type": "color", "$value": "{color.physical.info}" }
    },

    "background": {
      "$description": "By intent. Each is a role token under a functional name — the API for style objects, canvas, SVG and plain CSS. In a Tailwind class use the role: bg-tertiary-card, bg-primary-500/10.",
      "page": { "$type": "color", "$value": "{color.tertiary.bg}" },
      "surface": { "$type": "color", "$value": "{color.tertiary.card}" },
      "raised": { "$type": "color", "$value": "{color.tertiary.raised}" },
      "scrim": { "$type": "color", "$value": "{color.tertiary.shade}", "$extensions": { "norav.alpha": 0.8 } },
      "subtle": { "$type": "color", "$value": "{color.tertiary.ink}", "$extensions": { "norav.alpha": 0.03 } },
      "accent": { "$type": "color", "$value": "{color.primary.500}" },
      "accent-subtle": { "$type": "color", "$value": "{color.primary.500}", "$extensions": { "norav.alpha": 0.1 } },
      "accent-secondary": { "$type": "color", "$value": "{color.secondary.500}" },
      "accent-secondary-subtle": { "$type": "color", "$value": "{color.secondary.500}", "$extensions": { "norav.alpha": 0.1 } },
      "disabled": { "$type": "color", "$value": "{color.tertiary.ink}", "$extensions": { "norav.alpha": 0.06 } }
    },
    "text": {
      "primary": { "$type": "color", "$value": "{color.tertiary.fg}" },
      "secondary": { "$type": "color", "$value": "{color.tertiary.muted}" },
      "tertiary": { "$type": "color", "$value": "{color.tertiary.ink}", "$extensions": { "norav.alpha": 0.45 }, "$description": "captions, hints, the 45% ink the site sets small print in" },
      "inverse": { "$type": "color", "$value": "{color.primary.fg}", "$description": "text on the accent" },
      "accent": { "$type": "color", "$value": "{color.primary.400}" },
      "accent-secondary": { "$type": "color", "$value": "{color.secondary.400}" },
      "disabled": { "$type": "color", "$value": "{color.tertiary.ink}", "$extensions": { "norav.alpha": 0.3 } }
    },
    "border": {
      "default": { "$type": "color", "$value": "{color.tertiary.line}" },
      "subtle": { "$type": "color", "$value": "{color.tertiary.line-soft}" },
      "strong": { "$type": "color", "$value": "{color.tertiary.ink}", "$extensions": { "norav.alpha": 0.2 } },
      "accent": { "$type": "color", "$value": "{color.primary.500}", "$extensions": { "norav.alpha": 0.3 } },
      "focus": { "$type": "color", "$value": "{color.primary.500}" },
      "disabled": { "$type": "color", "$value": "{color.tertiary.ink}", "$extensions": { "norav.alpha": 0.04 } }
    },
    "interactive": {
      "$description": "Fills and text of things that can be pressed. Hover lightens a step, active darkens one.",
      "default": { "$type": "color", "$value": "{color.primary.500}" },
      "hover": { "$type": "color", "$value": "{color.primary.400}" },
      "active": { "$type": "color", "$value": "{color.primary.600}" },
      "subtle": { "$type": "color", "$value": "{color.primary.500}", "$extensions": { "norav.alpha": 0.1 } },
      "secondary-default": { "$type": "color", "$value": "{color.secondary.500}" },
      "secondary-hover": { "$type": "color", "$value": "{color.secondary.400}" },
      "secondary-active": { "$type": "color", "$value": "{color.secondary.600}" },
      "disabled": { "$type": "color", "$value": "{color.tertiary.ink}", "$extensions": { "norav.alpha": 0.15 } },
      "disabled-text": { "$type": "color", "$value": "{color.tertiary.ink}", "$extensions": { "norav.alpha": 0.3 } }
    }
  },

  "typography": {
    "font-family": {
      "display": { "$type": "fontFamily", "$value": ["Inter Tight", "Inter", "system-ui", "sans-serif"], "$description": "headings — ships at 900 only" },
      "sans": { "$type": "fontFamily", "$value": ["Inter", "system-ui", "sans-serif"], "$description": "body" },
      "mono": { "$type": "fontFamily", "$value": ["JetBrains Mono", "ui-monospace", "monospace"], "$description": "labels, numbers, code" }
    },
    "font-weight": {
      "normal": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "black": { "$type": "fontWeight", "$value": 900 }
    },
    "heading": {
      "$description": "Display sizes, in the display face. Fluid: the clamp is the implementation; the -mobile/-tablet/-desktop tokens are the same clamp evaluated at each breakpoint, for a developer who needs a number.",
      "display": { "$type": "typography", "$value": { "fontFamily": "{typography.font-family.display}", "fontSize": "clamp(3.5rem, 5vw + 2rem, 7rem)", "fontWeight": "{typography.font-weight.black}", "lineHeight": 0.98, "letterSpacing": "-0.03em" }, "$description": "the hero name" },
      "xlarge": { "$type": "typography", "$value": { "fontFamily": "{typography.font-family.display}", "fontSize": "clamp(2.75rem, 4vw + 1.5rem, 5rem)", "fontWeight": "{typography.font-weight.black}", "lineHeight": 1.02, "letterSpacing": "-0.02em" }, "$description": "a page title" },
      "large": { "$type": "typography", "$value": { "fontFamily": "{typography.font-family.display}", "fontSize": "clamp(2.25rem, 3vw + 1.25rem, 3.75rem)", "fontWeight": "{typography.font-weight.black}", "lineHeight": 1.05, "letterSpacing": "-0.015em" }, "$description": "the section heading" },
      "medium": { "$type": "typography", "$value": { "fontFamily": "{typography.font-family.display}", "fontSize": "clamp(1.75rem, 2vw + 1rem, 2.75rem)", "fontWeight": "{typography.font-weight.black}", "lineHeight": 1.1, "letterSpacing": "-0.01em" }, "$description": "a sub-heading, a big number" },
      "small": { "$type": "typography", "$value": { "fontFamily": "{typography.font-family.display}", "fontSize": "clamp(1.375rem, 1vw + 1rem, 1.875rem)", "fontWeight": "{typography.font-weight.black}", "lineHeight": 1.2, "letterSpacing": "-0.01em" }, "$description": "a card title, a metric" }
    },
    "body": {
      "large": { "$type": "typography", "$value": { "fontFamily": "{typography.font-family.sans}", "fontSize": "clamp(1.0625rem, 0.4vw + 1rem, 1.25rem)", "fontWeight": "{typography.font-weight.normal}", "lineHeight": 1.6, "letterSpacing": "0" }, "$description": "lead paragraphs" },
      "regular": { "$type": "typography", "$value": { "fontFamily": "{typography.font-family.sans}", "fontSize": "1rem", "fontWeight": "{typography.font-weight.normal}", "lineHeight": 1.6, "letterSpacing": "0" }, "$description": "body" },
      "small": { "$type": "typography", "$value": { "fontFamily": "{typography.font-family.sans}", "fontSize": "0.875rem", "fontWeight": "{typography.font-weight.normal}", "lineHeight": 1.55, "letterSpacing": "0" }, "$description": "dense UI, table cells" }
    },
    "caption": {
      "$type": "typography",
      "$value": { "fontFamily": "{typography.font-family.sans}", "fontSize": "0.75rem", "fontWeight": "{typography.font-weight.normal}", "lineHeight": 1.5, "letterSpacing": "0" },
      "$description": "captions, badges, small print"
    },
    "label": {
      "$type": "typography",
      "$value": { "fontFamily": "{typography.font-family.mono}", "fontSize": "0.7rem", "fontWeight": "{typography.font-weight.medium}", "lineHeight": 1.4, "letterSpacing": "0.2em", "textTransform": "uppercase" },
      "$description": "eyebrows, table headers, badges — always mono, uppercase, tracked wide"
    }
  },

  "spacing": {
    "$description": "A 4px base. The named steps are for CSS and code (`var(--spacing-md)`, `tokens.spacing.md`); in a class use Tailwind's numeric scale — a named step in @theme would shadow the container sizes in max-w-*. The responsive ones are utilities too: px-gutter-x, py-section-y.",
    "2xs": { "$type": "dimension", "$value": "4px" },
    "xs": { "$type": "dimension", "$value": "8px" },
    "sm": { "$type": "dimension", "$value": "12px" },
    "md": { "$type": "dimension", "$value": "16px" },
    "lg": { "$type": "dimension", "$value": "24px" },
    "xl": { "$type": "dimension", "$value": "32px" },
    "2xl": { "$type": "dimension", "$value": "48px" },
    "3xl": { "$type": "dimension", "$value": "64px" },
    "4xl": { "$type": "dimension", "$value": "96px" },
    "gutter-x": {
      "$type": "dimension",
      "$description": "The horizontal inset of a section — px-6 md:px-16 today.",
      "$value": { "mobile": "24px", "tablet": "40px", "desktop": "64px" }
    },
    "section-y": {
      "$type": "dimension",
      "$description": "The vertical rhythm between sections.",
      "$value": { "mobile": "80px", "tablet": "96px", "desktop": "96px" }
    },
    "card-padding": {
      "$type": "dimension",
      "$description": "Inside a card — p-6 md:p-8 today.",
      "$value": { "mobile": "24px", "tablet": "32px", "desktop": "32px" }
    },
    "stack": {
      "$type": "dimension",
      "$description": "Between a heading and the content under it.",
      "$value": { "mobile": "32px", "tablet": "40px", "desktop": "48px" }
    }
  },

  "breakpoint": {
    "$description": "Tailwind's, so `md:` in a class and `--breakpoint-md` in CSS agree. Three tiers for the responsive tokens: mobile is below md, tablet is md to lg, desktop is lg and up.",
    "sm": { "$type": "dimension", "$value": "640px" },
    "md": { "$type": "dimension", "$value": "768px" },
    "lg": { "$type": "dimension", "$value": "1024px" },
    "xl": { "$type": "dimension", "$value": "1280px" },
    "tier": {
      "mobile": { "$type": "dimension", "$value": "375px", "$description": "the width the -mobile tokens are evaluated at" },
      "tablet": { "$type": "dimension", "$value": "768px" },
      "desktop": { "$type": "dimension", "$value": "1280px" }
    }
  },

  "radius": {
    "xs": { "$type": "dimension", "$value": "2px" },
    "sm": { "$type": "dimension", "$value": "4px" },
    "md": { "$type": "dimension", "$value": "8px" },
    "lg": { "$type": "dimension", "$value": "12px" },
    "xl": { "$type": "dimension", "$value": "20px" },
    "2xl": { "$type": "dimension", "$value": "28px" },
    "3xl": { "$type": "dimension", "$value": "36px" },
    "full": { "$type": "dimension", "$value": "9999px" }
  }
}
