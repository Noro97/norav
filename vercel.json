{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/cv",
      "destination": "/Norayr_Avetisyan_CV.pdf",
      "permanent": false
    },
    {
      "source": "/automation",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/experience",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/skills",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/work/logistics",
      "destination": "/demos/nexusroute",
      "permanent": true
    },
    {
      "source": "/work/ecommerce",
      "destination": "/demos/filtergraph",
      "permanent": true
    },
    {
      "source": "/work/merch",
      "destination": "/demos/merchforge",
      "permanent": true
    },
    {
      "source": "/work/omnigrid",
      "destination": "/demos/omnigrid",
      "permanent": true
    },
    {
      "source": "/site",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/ru",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/ru/:path*",
      "destination": "/:path*",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/assets/([^/]+)-([A-Za-z0-9_-]{8})\\.(js|css|woff2|woff)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
