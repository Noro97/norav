{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* The portfolio kit under src/components/portfolio-kit is .jsx, kept that
       way so a re-sync from the source project stays a copy. It is not type
       checked (checkJs stays off); consumers go through its typed barrels. */
    "allowJs": true,

    /* Path aliases */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@norav/content-schema": ["./packages/content-schema/src/index.ts"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["src", "packages/content-schema/src", "server", "api", "vite-api-plugin.ts", "vitest.setup.ts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}