        {
          "id": "cd7c1d59-6165-432f-bb65-5f0d1d734cc1",
          "type": "bento_grid",
          "content": {
            "tiles": [
              {
                "slot": 0,
                "title": "Аудит производительности",
                "description": "Стандартные маркеры Google Maps вызывали зависания основного потока при 500+ обновлениях. Перешли на Advanced Markers с буфером rAF — снижение нагрузки на 70%, стабильные 60 FPS."
              },
              {
                "slot": 1,
                "title": "Типобезопасная архитектура",
                "description": "Сквозная система типов между бэкендом на Node.js и фронтендом на React, устранившая 99% ошибок API во время выполнения"
              },
              {
                "slot": 2,
                "title": "Пользовательский опыт",
                "description": "Система предиктивного ввода для сложных форм, сократившая время создания отправления на 15 секунд"
              },
              {
                "slot": 3,
                "title": "ИИ-детекция",
                "description": "Мультимодальная ИИ-верификация с точностью 98.4% через анализ видеодоказательств пользователей с помощью Gemini."
              },
              {
                "slot": 4,
                "title": "Cache Hit-Rate",
                "description": "Виртуализированная таблица на 10K+ строк с суб-миллисекундными кэш-запросами через стратегию TanStack Query stale-while-revalidate."
              }
            ],
            "title": "Инженерное влияние",
