# Copy to `.env` and fill in real values. `.env` is gitignored — never commit it.

# Server/build-time only. NOT exposed to the client bundle (no VITE_ prefix).
# Keep it that way: anything VITE_-prefixed is inlined into the shipped JS.
ANTHROPIC_API_KEY=

# Injected automatically by the Vercel CLI during local dev. Short-lived; leave blank.
VERCEL_OIDC_TOKEN=

# Client-side (inlined into the bundle by design — Google Maps requires it browser-side).
# Protect it by restricting the key to your deployed domain(s) in Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
