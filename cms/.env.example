# Leave DATABASE_URL empty for local development: the CMS then runs on an
# embedded PGlite database under cms/.pglite and applies db/migrations itself.
# Set it to the Neon connection string for staging/production.
DATABASE_URL=

# Origin allowed to call the public content API (the portfolio site).
SITE_ORIGIN=https://norav.dev

# Media storage. Unset = uploads go to cms/.media and are served by this app,
# which is what local development wants. Set it to a Vercel Blob read-write
# token in production and uploads go to the blob store instead.
BLOB_READ_WRITE_TOKEN=

# Absolute origin of this app, used to build URLs for locally stored uploads.
# Leave blank: development falls back to http://localhost:3300, and production
# stores uploads in the blob store, which returns its own absolute URLs.
CMS_PUBLIC_URL=

# Vercel deploy hook for the *site* project. When set, publishing asks the site
# to rebuild so its baked snapshot catches up. Optional: without it the site
# still picks up new content at runtime, one page load later.
SITE_DEPLOY_HOOK_URL=
