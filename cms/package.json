{
  "name": "@norav/cms",
  "version": "0.1.0",
  "private": true,
  "description": "norav CMS \u2014 admin UI and content API for the norav.dev portfolio",
  "scripts": {
    "dev": "next dev -p 3300",
    "dev:local": "DATABASE_URL= BLOB_READ_WRITE_TOKEN= next dev -p 3300",
    "build": "next build",
    "start": "next start -p 3300",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "user:add": "DATABASE_URL= tsx --env-file-if-exists=.env scripts/create-user.mts",
    "user:add:production": "tsx --env-file-if-exists=.env scripts/create-user.mts --production",
    "seed": "DATABASE_URL= tsx --env-file-if-exists=.env scripts/seed.mts",
    "seed:production": "tsx --env-file-if-exists=.env scripts/seed.mts --production",
    "import": "DATABASE_URL= tsx --env-file-if-exists=.env scripts/import-content.mts",
    "import:production": "tsx --env-file-if-exists=.env scripts/import-content.mts --production",
    "import:media": "DATABASE_URL= tsx --env-file-if-exists=.env scripts/import-media.mts",
    "import:media:production": "tsx --env-file-if-exists=.env scripts/import-media.mts --production",
    "pull:production": "tsx --env-file-if-exists=.env scripts/pull-production.mts",
    "link:images": "DATABASE_URL= tsx --env-file-if-exists=.env scripts/link-block-images.mts",
    "link:images:production": "tsx --env-file-if-exists=.env scripts/link-block-images.mts --production",
    "db:reset": "rm -rf .pglite && npm run seed && npm run import"
  },
  "dependencies": {
    "@norav/content-schema": "file:../packages/content-schema",
    "@vercel/blob": "^2.8.0",
    "next": "^15.5.24",
    "pg": "^8.13.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.35.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.7",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
