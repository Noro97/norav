{
  "name": "monolite",
  "type": "module",
  "description": "Creative landing page with liquid glass effects and animations",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "content:pull": "CMS_URL=${CMS_URL:-http://localhost:3300} node scripts/fetch-content.mjs",
    "content:backfill": "tsx scripts/backfill-snapshot-defaults.mts",
    "illustrations": "node scripts/generate-illustrations.mjs",
    "prebuild": "node scripts/fetch-content.mjs && node scripts/generate-sitemap.mjs",
    "build": "tsc && vite build",
    "lint": "eslint src packages server api vite-api-plugin.ts vite.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fontsource/inter-tight": "^5.2.7",
    "@googlemaps/js-api-loader": "^2.0.2",
    "@gsap/react": "^2.1.2",
    "@norav/content-schema": "*",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@splinetool/react-spline": "^4.1.0",
    "@splinetool/runtime": "^1.12.69",
    "@tanstack/react-query": "^5.91.0",
    "@tanstack/react-table": "^8.21.3",
    "@types/canvas-confetti": "^1.9.0",
    "@warmbros/warmbros-components": "^0.1.1",
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^12.23.24",
    "gsap": "^3.14.2",
    "i18next": "^25.8.18",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.546.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.5.8",
    "react-router": "^7.18.3",
    "simplex-noise": "^4.0.3",
    "three": "^0.183.2",
    "web-vitals": "^5.3.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.1.16",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/geojson": "^7946.0.16",
    "@types/google.maps": "^3.58.1",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^6.3.5",
    "vitest": "^4.1.0"
  }
}
