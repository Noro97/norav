{
  "name": "monolite",
  "type": "module",
  "description": "Creative landing page with liquid glass effects and animations",
  "scripts": {
    "dev": "vite",
    "dev:sandbox": "wrangler pages dev dist --ip 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "wrangler pages dev dist",
    "deploy": "npm run build && wrangler pages deploy dist",
    "deploy:prod": "npm run build && wrangler pages deploy dist --project-name monolite",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "clean-port": "fuser -k 3000/tcp 2>/dev/null || true",
    "test": "curl http://localhost:3000",
    "start": "pm2 start ecosystem.config.cjs",
    "stop": "pm2 delete monolite",
    "logs": "pm2 logs monolite --nostream",
    "git:commit": "git add . && git commit -m"
  },
  "dependencies": {
    "hono": "^4.9.12"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.2.0",
    "@hono/vite-dev-server": "^0.18.2",
    "vite": "^6.3.5",
    "wrangler": "^4.4.0"
  }
}