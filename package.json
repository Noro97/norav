{
  "name": "monolite",
  "type": "module",
  "description": "Creative landing page with liquid glass effects and animations",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "tokens": "node packages/design-tokens/scripts/build.mjs",
    "content:pull": "CMS_URL=${CMS_URL:-http://localhost:3300} node scripts/fetch-content.mjs",
    "content:check": "CMS_URL=${CMS_URL:-https://cms.norav.dev} node scripts/fetch-content.mjs --check",
    "content:backfill": "tsx scripts/backfill-snapshot-defaults.mts",
    "illustrations": "node scripts/generate-illustrations.mjs",
    "prebuild": "node scripts/fetch-content.mjs && node scripts/generate-sitemap.mjs",
    "build": "tsc && vite build && vite build --ssr src/entry-server.tsx --outDir node_modules/.cache/prerender --emptyOutDir && node scripts/prerender.mjs",
    "size:check": "node scripts/check-bundle-size.mjs",
    "prerender:check": "node scripts/check-prerender.mjs",
    "lint": "eslint src packages server api vite-api-plugin.ts vite-profile-plugin.ts vite-preview-plugin.ts vite.config.ts --max-warnings=0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/inter-tight": "^5.2.7",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@norav/content-schema": "*",
    "@norav/design-tokens": "*",
    "@tanstack/react-query": "^5.91.0",
    "@tanstack/react-table": "^8.21.3",
    "@types/canvas-confetti": "^1.9.0",
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^12.23.24",
    "i18next": "^25.8.18",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.5.8",
    "react-router": "^7.18.3",
    "web-vitals": "^5.3.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/oxide": "^4.1.16",
    "@tailwindcss/postcss": "^4.1.16",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^6.3.5",
    "vitest": "^4.1.0"
  }
}
